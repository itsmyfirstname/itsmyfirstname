---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { getProjects, projectDates } from "../../lib/projects";

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, description, startDate, endDate, tags } = project.data;
---

<Base title={title} description={description}>
  <article class="prose">
    <h1>{title}</h1>
    <p class="muted">
      {description}
      {startDate && <> · {projectDates(startDate, endDate)}</>}
    </p>
    {
      tags.length > 0 && (
        <ul class="tags">
          {tags.map((t) => (
            <li class="tag">{t}</li>
          ))}
        </ul>
      )
    }
    <Content />
  </article>
  <hr />
  <p><a href="/projects/">← all projects</a></p>
</Base>
