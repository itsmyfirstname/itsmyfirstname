---
import Base from "../../layouts/Base.astro";
import { getProjects, projectDates } from "../../lib/projects";

const projects = await getProjects();
const groups = (["work", "fun"] as const)
  .map((category) => ({ category, items: projects.filter((p) => p.data.category === category) }))
  .filter((g) => g.items.length > 0);
---

<Base title="Projects" description="Things I've built or am building, at work and for fun.">
  <h1>Projects</h1>
  <p class="muted">Things I've built or am building, at work and for fun.</p>
  {groups.length === 0 && <p>Nothing written up yet. Check back soon.</p>}
  {
    groups.map(({ category, items }) => (
      <section>
        <h2>{category}</h2>
        <div class="cards">
          {items.map((p) => (
            <a class="card" href={`/projects/${p.id}/`}>
              {p.data.image && <img src={p.data.image} alt="" />}
              <strong>
                {p.data.title}
                {p.data.draft && <span class="tag">draft</span>}
              </strong>
              <span>{p.data.description}</span>
              {p.data.startDate && <span>{projectDates(p.data.startDate, p.data.endDate)}</span>}
            </a>
          ))}
        </div>
      </section>
    ))
  }
</Base>
